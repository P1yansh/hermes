# Hermes Environment Configuration

# Runtime Topology:
# - "local": Developer workstation daemon coupled with Athena & local llama-server on GPU
# - "cloud_sandbox": Render demo environment using mock fixtures & deterministic heuristics
RUN_MODE="local"

# Ingestion Mode: "mock" (offline test fixture) or "live" (Google OAuth + Web)
DATA_SOURCE="mock"

# User Timezone for Deadline Normalization (e.g., "Asia/Kolkata", "America/New_York", "UTC")
USER_TIMEZONE="Asia/Kolkata"

# Local SQLite Database Path
DATABASE_PATH="data/hermes.db"

# Athena Local LLM Endpoint (Gemma 3 4B via llama-server)
LOCAL_LLM_URL="http://127.0.0.1:8080/v1"
LOCAL_LLM_MODEL="gemma-3-4b-it"
LOCAL_LLM_API_KEY="sk-athena-local"

# Multi-Account Manifest & Location
ACCOUNTS_CONFIG_PATH="config/accounts.json"
TOKENS_DIR="tokens"
USER_CITY="lucknow"
USER_COUNTRY="india"

# ElevenLabs Voice Briefing
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb" # George / calm narrator

# Google API Credentials (Required only when DATA_SOURCE="live")
GOOGLE_CREDENTIALS_PATH="credentials.json"
GOOGLE_TOKEN_PATH="token.json"

# SerpApi Key (Optional, for live Opportunity Scout)
SERPAPI_API_KEY=""

# Server Settings
HOST="0.0.0.0"
PORT="8000"
CORS_ORIGINS="*"
